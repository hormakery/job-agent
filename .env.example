# ============================================================================
# JobAgent OS Environment Configuration (Version 2.0.0)
# ============================================================================

# 1. Candidate Profile (Injected into application packages & cover emails)
CANDIDATE_NAME=Alex Mercer
CANDIDATE_EMAIL=alex.mercer@example.com
CANDIDATE_PHONE=+1 (555) 019-2834
CANDIDATE_LINKEDIN_URL=https://linkedin.com/in/alexmercer
CANDIDATE_GITHUB_URL=https://github.com/alexmercer
CANDIDATE_PORTFOLIO_URL=https://alexmercer.dev
CANDIDATE_LOCATION=San Francisco, CA (Open to Remote)

# 2. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# 3. Job Sourcing (Agent 1 - JSearch on RapidAPI)
JSEARCH_RAPIDAPI_KEY=your_rapidapi_key_here
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com

# 4. Existing Local ATS Checker Integration (Agent 2 Gatekeeper)
# Modes: "http_local" | "cli_subprocess" | "python_import" | "local_heuristic"
ATS_INTEGRATION_MODE=http_local
ATS_LOCAL_REPO_PATH=/Users/beebee/Desktop/personal project/ATS-Checker
ATS_LOCAL_HTTP_URL=http://127.0.0.1:5000/api/scans/analyze
ATS_CLI_COMMAND=
ATS_MATCH_THRESHOLD=50

# 5. Google Workspace (Sheets, Drive, Gmail, Calendar)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/token.json
GOOGLE_SHEET_ID=
GOOGLE_SHEET_WORKSHEET_NAME=Applications
GOOGLE_DRIVE_RESUME_FOLDER_ID=

# 6. Server & Frontend URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3001
