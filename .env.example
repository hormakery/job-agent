# ============================================================================
# Job-Agent Environment Configuration
# ============================================================================

# 1. Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# 2. Job Sourcing (Agent 1 - JSearch on RapidAPI)
JSEARCH_RAPIDAPI_KEY=your_rapidapi_key_here
JSEARCH_RAPIDAPI_HOST=jsearch.p.rapidapi.com

# 3. Existing Local ATS Checker Integration (Agent 2 Gatekeeper)
# Modes: "http_local" | "python_import" | "cli_subprocess" | "local_heuristic"
ATS_INTEGRATION_MODE=local_heuristic
ATS_LOCAL_REPO_PATH=/Users/beebee/Desktop/personal project/ats-checker
ATS_LOCAL_HTTP_URL=http://127.0.0.1:8001/evaluate
ATS_CLI_COMMAND=python3 ../ats-checker/main.py
ATS_MATCH_THRESHOLD=50

# 4. Google Workspace (Sheets, Drive, Gmail, Calendar)
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
GOOGLE_OAUTH_CREDENTIALS_FILE=credentials/client_secret.json
GOOGLE_OAUTH_TOKEN_FILE=credentials/token.json
GOOGLE_SHEET_ID=your_google_sheet_id_here
GOOGLE_SHEET_WORKSHEET_NAME=Applications
GOOGLE_DRIVE_RESUME_FOLDER_ID=your_google_drive_folder_id_here

# 5. Telegram Bot (Agent 4 Human-in-the-Loop)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# 6. Server & Frontend URLs
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
FRONTEND_URL=http://localhost:3000

